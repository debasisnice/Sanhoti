backend/data/DurgaPuja_Page/
backend/data/Hero_Slots/

# Local data backups
backend/data-local-backup-*/
backend/data/_workbook-backup/

# Runtime data — never tracked in git so a deploy can't overwrite production data.
# Prod keeps its own copies; deploy.yml backs up + restores backend/data/*.json
# around the hard reset. (Supersedes the previous per-file list, which missed the
# ticketing files — bookings, seat maps, ticket setups, etc.)
backend/data/*.json

# Word/Office lock files (created while a .docx is open)
~$*

# Timestamped data backups (recovery copies, may contain member PII).
# The *.json rule above does not match these — their suffix is a timestamp.
backend/data/_test-pollution-backup/
backend/data/_workbook-backup/
backend/data/*.corrupt-*

# Local workbook edit snapshots (canonical file is workbookData.json only).
backend/src/scripts/workbookData.json.*
